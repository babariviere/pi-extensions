{
  "name": "@babariviere/pi-extensions",
  "version": "0.1.0",
  "description": "Personal pi extensions: web search/fetch, secrets injection, Linear/PR helpers, context + footer UI.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent"
  ],
  "license": "MIT",
  "author": "babariviere",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babariviere/pi-extensions.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "pi-usage": "./cli/pi-usage.ts"
  },
  "pi": {
    "extensions": [
      "extensions/*/index.ts"
    ],
    "themes": [
      "themes/*.json"
    ]
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-durable": "1.1.0",
    "defuddle": "^0.19.1",
    "linkedom": "^0.18.13",
    "parse5": "^8.0.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "latest",
    "tsx": "^4.19.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.0",
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0",
    "typebox": "*"
  },
  "scripts": {
    "pi-usage": "node cli/pi-usage.ts",
    "test": "node --import tsx --test 'extensions/**/*.test.ts' 'cli/**/*.test.ts'",
    "typecheck": "tsgo -p tsconfig.json",
    "fmt": "biome format --write .",
    "fmt:check": "biome format ."
  }
}
